# ---------- Authentication (admin) ----------
# Secret used to sign the admin session JWT. Use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Admin login. Either set a bcrypt hash (recommended) OR a plaintext password.
ADMIN_USERNAME=admin
# Recommended: bcrypt hash of your password (generate with: node scripts/hash-password.js "yourpass")
ADMIN_PASSWORD_HASH=
# Fallback plaintext password (used only if ADMIN_PASSWORD_HASH is empty)
ADMIN_PASSWORD=change-me

# ---------- GitHub (content storage) ----------
# Fine-grained PAT with "Contents: Read and write" on the portfolio repo only.
# NEVER expose this to the browser. Server-side only.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-portfolio-repo
GITHUB_BRANCH=main

# ---------- Cloudinary (image storage) ----------
# Cloud name + an UNSIGNED upload preset are safe to use from the browser.
# Do NOT put your Cloudinary API secret here (not needed for unsigned uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=portfolio
